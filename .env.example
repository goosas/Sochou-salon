# ============================================================
# SOCHOU HAIR BEAUTY SALON - Variables d'environnement
# ============================================================
# Ce fichier est un exemple. Copiez-le en .env pour usage local.
# NOTE: les clés du SDK web Firebase ne sont pas des secrets.
# La sécurité réelle repose sur les règles Firestore + auth.

# Configuration Firebase (SDK web)
FIREBASE_API_KEY=your_api_key_here
FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=your_app_id

# Email de l'administrateur (pour documentation)
ADMIN_EMAIL=admin@sochoubeauty.com
